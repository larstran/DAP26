# ==============================================================================
# MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG (COMMIT LÊN GIT LÀM MẪU CHO NHÓM PHÁT TRIỂN)
# Hướng dẫn: Sao chép file này thành .env và điền API Key thực tế của bạn
# Lệnh sao chép: copy .env.example .env
# ==============================================================================

# Google Gemini API Key (Lấy tại: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Cấu hình Model Gemini (Tùy chọn: Gemini 3.1 Flash Lite, Gemini 3.8 Flash, gemini-2.5-flash)
GEMINI_MODEL=Gemini 3.1 Flash Lite
